# ==============================================================================
# ZonaFit — Backend Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN REAL VALUES.
# NEVER COMMIT .env TO GIT.
# ==============================================================================

# ── Database ───────────────────────────────────────────────────────────────────
# Separate host/port/name/user/password (used by database.py and alembic/env.py)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zonafit_db
DB_USER=zonafit_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Authentication / JWT ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Alias used by config.py — keep in sync with ACCESS_TOKEN_EXPIRE_MINUTES
TOKEN_EXPIRATION_MINUTES=60

# ── Environment ────────────────────────────────────────────────────────────────
# Allowed values: development | preproduction | production
ENVIRONMENT=development

# ── CORS — Frontend origins ────────────────────────────────────────────────────
# Comma-separated list. For production: your real HTTPS domain only.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# ── Wompi (Pagos) ──────────────────────────────────────────────────────────────
# IMPORTANT: Use SANDBOX keys during preproduction. NEVER use prod keys in .env.
# Obtain from: https://comercios.wompi.co/
WOMPI_ENVIRONMENT=SANDBOX
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_XXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXX
WOMPI_EVENTS_SECRET=events_test_XXXXX
WOMPI_INTEGRITY_SECRET=integrity_test_XXXXX

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────────────────
# Obtain from: https://developers.facebook.com/apps/ → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v17.0

# ── SMTP (Email) ───────────────────────────────────────────────────────────────
# For password reset emails. Leave empty to disable email sending.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@YOUR_DOMAIN
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@zonafit.com

# ── Optional Tuning ────────────────────────────────────────────────────────────
# SQL_ECHO=false  — set to 'true' ONLY for local query debugging. NEVER in prod.
SQL_ECHO=false
