# ZonaFit Frontend — Environment Configuration
# COPY TO .env AND SET YOUR VALUES. NEVER COMMIT .env TO GIT.
# Only VITE_* variables are exposed in the browser bundle — treat them as public.

# ── Development ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Preproduction / Production ─────────────────────────────────────────────────
# Uncomment and set to your real backend domain when building for deployment.
# VITE_API_URL=https://api.zonafit.tu-dominio.com
